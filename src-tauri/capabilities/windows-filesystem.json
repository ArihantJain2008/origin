{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "windows-filesystem",
  "description": "Read-only filesystem access for Origin projects on Windows",
  "platforms": ["windows"],
  "windows": ["main", "overlay"],
  "permissions": [
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "C:/origin"
        },
        {
          "path": "C:/origin/**/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "C:/origin/**/*"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "C:/origin/**/*"
        }
      ]
    }
  ]
}