{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "fs:read-all",

    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "C:/origin"
        },
        {
          "path": "C:/origin/**/*"
        }
      ]
    },

    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "C:/origin/**/*"
        }
      ]
    },

    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "C:/origin/**/*"
        }
      ]
    },

    "shell:default",
    "shell:allow-execute"
  ]
}