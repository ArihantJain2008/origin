{
  "$schema": "https://schema.tauri.app/config/2",

  "productName": "origin",

  "version": "0.1.1",

  "identifier": "com.origin.app",

  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },

  "app": {
    "windows": [
      {
        "title": "origin",
        "width": 800,
        "height": 600
      }
    ],

    "security": {
      "csp": null
    }
  },

  "bundle": {
    "active": true,

    "targets": "all",

    "createUpdaterArtifacts": true,

    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },

  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCQjc5Q0UzMzBCNzE3MQpSV1J4Y1FzenpubTdBZlVOcWt1V0tCVkczSFRRd05HQTl0MGROcEluTGdVTEJ6cVNNYlBxUnczUAo=",

      "endpoints": [
        "https://github.com/ArihantJain2008/origin/releases/latest/download/latest.json"
      ],

      "windows": {
        "installMode": "passive"
      }
    }
  }
}